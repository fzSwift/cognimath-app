{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": []
  },
  "include": [
    "src/core/engine.js",
    "src/core/data.js",
    "src/core/tutor.js",
    "src/lib/validate.js",
    "src/types/**/*.d.ts",
    "../shared/**/*.d.ts"
  ]
}
